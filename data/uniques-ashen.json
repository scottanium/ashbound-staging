{
  "rules": {
    "about": "Level-50 Ashen versions of every unique, for harder endgame (rifts, later First Kiln, White Ash Mael). Originals are unchanged and cap at Fabled. Generated from data/items.json with the rules below. The light boss heal cap still applies, so a full Ashen Mythical kit is not immortal in rifts.",
    "idPrefix": "ashen_",
    "namePrefix": "Ashen ",
    "qlvl": 50,
    "reqLevel": 50,
    "ilvl": 50,
    "dropMinLevel": 45,
    "lateZones": [
      "quiet_fields",
      "stair_of_names",
      "first_kiln"
    ],
    "allowHighRift": true,
    "craftable": false,
    "cubable": false,
    "tier": "mythical",
    "scale": {
      "about": "Linear interpolation between qlvl 3 = x2.00 and qlvl 48 (Kilntooth) = x1.15.",
      "formula": "1.15 + 0.85 * (48 - origQlvl) / 45",
      "lowQlvl": 3,
      "highQlvl": 48,
      "lowMul": 2.0,
      "highMul": 1.15
    },
    "effectScaleKeys": [
      "damage",
      "absorb",
      "heal",
      "mana",
      "amount",
      "move",
      "ias",
      "absorbMax"
    ],
    "allSkillsCap": 2,
    "skillRank": {
      "plusAt": 1.3,
      "plus2At": 1.7,
      "hardCap": 3
    },
    "outliers": [
      "sallow_crown",
      "mawglass",
      "kiln_tyrants_collar",
      "last_watch_plate",
      "kept_bell"
    ],
    "outlierNote": "Ashen Mythical signature, capstone, and Last Watch absorb are trimmed so each of the five outliers stays within ~15% of its slot's next-best Ashen Mythical. Ordinary mods still use the full ashen scale. Campaign (non-Ashen) uniques are not trimmed and cap at Fabled.",
    "campaignTarget": "Original uniques cap at Fabled and are tuned for the campaign. The light 4% boss heal cap only stops on-hit heals and life steal from fully cancelling incoming damage. There is no Mael-difficulty floor for a unique kit: Mael is paced separately against level-appropriate Elite gear.",
    "endgameTarget": "Ashen L50 uniques can be Mythical and are stronger (x1.15\u2013x2.00 by original qlvl) for rifts and later First Kiln / White Ash Mael. The same heal cap applies so they can still be threatened. Outlier signatures stay within ~15% of the slot's next-best Ashen."
  },
